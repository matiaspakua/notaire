# Notaire QA suites — environment template.
#   cp testing/.env.example testing/.env
# Lookup used by testing/scripts/run.sh: $TESTING_ENV_FILE, then testing/.env (git-ignored).
# Values are local placeholders only; never commit real credentials.

# --- integration suite: the running stack under test --------------------------
BASE_URL=http://localhost:8080

# --- database suite -----------------------------------------------------------
# Flyway migrations to apply (read-only). Relative paths resolve from testing/.
# While testing/ sits inside the application repository the default is the backend's own folder.
MIGRATIONS_DIR=../backend-api/src/main/resources/db/migration
# Flyway placeholders migration V12 needs; the backend supplies the same two at runtime.
POSTGRES_EXPORTER_USER=notaire_exporter
POSTGRES_EXPORTER_PASSWORD=vv-exporter-throwaway
# Password of the throwaway PostgreSQL the suite starts (never published on a host port).
DB_VV_PASSWORD=vv-throwaway
