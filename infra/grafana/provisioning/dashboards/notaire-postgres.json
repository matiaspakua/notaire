{
  "title": "Notaire PostgreSQL Database",
  "version": 1,
  "uid": "notaire-postgres",
  "description": "Monitoring dashboard for Notaire PostgreSQL database",
  "tags": ["notaire", "postgresql", "database"],
  "schemaVersion": 36,
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "title": "Database Size",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname='notaire'}",
          "legendFormat": "Size"
        }
      ],
      "description": "Current database size in bytes"
    },
    {
      "title": "Active Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname='notaire'}",
          "legendFormat": "Connections"
        }
      ],
      "description": "Currently active database connections"
    },
    {
      "title": "Cache Hit Ratio",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "(sum(blks_hit) / (sum(blks_hit) + sum(blks_read))) * 100",
          "legendFormat": "Hit ratio"
        }
      ],
      "description": "PostgreSQL buffer cache hit ratio"
    },
    {
      "title": "Transactions",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname='notaire'}[1m])",
          "legendFormat": "Commits"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname='notaire'}[1m])",
          "legendFormat": "Rollbacks"
        }
      ],
      "description": "Transaction commit and rollback rates"
    },
    {
      "title": "Database Connections by State",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "pg_connections_total{datname='notaire'}",
          "legendFormat": "{{state}}"
        }
      ],
      "description": "Connection count by state"
    },
    {
      "title": "Notaire Business Metrics - Tables",
      "type": "graph",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "escrituras_total",
          "legendFormat": "Escrituras ({{estado_nombre}})"
        },
        {
          "expr": "presupuestos_total",
          "legendFormat": "Presupuestos total"
        },
        {
          "expr": "personas_total",
          "legendFormat": "Personas total"
        },
        {
          "expr": "usuarios_total",
          "legendFormat": "Usuarios total"
        }
      ],
      "description": "Notaire business entity counts from the database"
    },
    {
      "title": "Database Operations Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "targets": [
        {
          "expr": "rate(notaire_database_operation_duration_sum[1m])",
          "legendFormat": "{{operation}} - {{table}}"
        }
      ],
      "description": "Database operation rates by type and table"
    },
    {
      "title": "Block I/O",
      "type": "graph",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "targets": [
        {
          "expr": "rate(pg_stat_database_blks_read{datname='notaire'}[1m])",
          "legendFormat": "Reads"
        },
        {
          "expr": "rate(pg_stat_database_blks_hit{datname='notaire'}[1m])",
          "legendFormat": "Cache hits"
        }
      ],
      "description": "Block I/O rates for the database"
    },
    {
      "title": "System Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 }
    }
  ]
}
