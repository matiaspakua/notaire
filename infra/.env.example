# Notaire infra — environment template.
#   cp infra/.env.example infra/.env
# Lookup order used by scripts/common.sh: $INFRA_ENV_FILE, infra/.env, then the
# application's root .env. infra/.env is git-ignored; never commit real values.
# The values below are local-development placeholders only.
# INSECURE PLACEHOLDERS — CHANGE BEFORE ANY SHARED OR PRODUCTION USE.

# --- Application database (read by the postgres exporter) -------------------
POSTGRES_DB=notaire

# --- PostgreSQL metrics-exporter role (least-privilege, pg_monitor only) ----
# Role is created by Flyway migration V12 in the application (issue #675).
POSTGRES_EXPORTER_USER=notaire_exporter
POSTGRES_EXPORTER_PASSWORD=admin

# --- Backend Actuator scrape credentials (HTTP Basic) -----------------------
# Must match the backend's ACTUATOR_* and the basic_auth block in
# observability/prometheus/prometheus.yml.
ACTUATOR_USER=admin
ACTUATOR_PASSWORD=admin

# --- Grafana (http://localhost:3001) ----------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- SonarQube database (internal) ------------------------------------------
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar

# --- SonarQube (http://localhost:9000) --------------------------------------
# Initial credentials; scripts/run-sonar.sh handles the forced first-login change.
SONAR_ADMIN_USER=admin
SONAR_ADMIN_PASSWORD=Admin@123456
# Generated by scripts/run-sonar.sh and written back to this file.
SONAR_TOKEN=
