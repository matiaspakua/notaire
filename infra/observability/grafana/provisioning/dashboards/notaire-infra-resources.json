    },
    {
      "title": "Observability health",
      "type": "link",
      "url": "/d/notaire-observability-health",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Traces",
      "type": "link",
      "url": "/d/notaire-traces",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Backend API",
      "type": "link",
