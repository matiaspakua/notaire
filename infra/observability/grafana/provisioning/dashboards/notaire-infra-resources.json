{
  "uid": "notaire-infra-resources",
  "title": "Notaire - Infra Resources",
  "description": "CPU, memory, load, disk and network of the Docker host, and aggregate container usage. On Docker Desktop these describe the Linux VM.",
  "tags": [
    "notaire",
    "infra",
    "resources"
  ],
  "schemaVersion": 36,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Stack status",
      "type": "link",
      "url": "/d/notaire-stack-status",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Notaire status",
      "type": "link",
      "url": "/d/notaire-status",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
