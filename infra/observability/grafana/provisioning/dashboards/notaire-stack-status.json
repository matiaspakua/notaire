{
  "uid": "notaire-stack-status",
  "title": "Notaire - Technology Stack Status",
  "description": "First-response view of every service in the Notaire and observability stack: availability, firing alerts, and recent errors.",
  "tags": [
    "notaire",
    "overview",
    "stack",
    "status"
  ],
  "schemaVersion": 36,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Backend API",
      "type": "link",
      "url": "/d/notaire-backend",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "url": "/d/notaire-postgres",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Authentication",
      "type": "link",
      "url": "/d/notaire-auth",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Logs",
      "type": "link",
      "url": "/d/notaire-logs",
      "icon": "dashboard",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Services up",
      "description": "Of 11 probed services",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(probe_success == 1) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 11
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Services down",
      "description": "",
