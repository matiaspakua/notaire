{
  "uid": "notaire-status",
  "title": "Notaire - Application Status",
  "description": "Concise status of the Notaire application: frontend, backend API, PostgreSQL and pgAdmin availability, alerts, API health, and recent errors.",
  "tags": [
    "notaire",
    "overview",
    "status"
  ],
  "schemaVersion": 36,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Backend API",
      "type": "link",
      "url": "/d/notaire-backend",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "PostgreSQL",
