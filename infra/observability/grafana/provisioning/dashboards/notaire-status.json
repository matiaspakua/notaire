      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Logs",
      "type": "link",
      "url": "/d/notaire-logs",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Infra resources",
