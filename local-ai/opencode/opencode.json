{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "lsp": false,
  "formatter": false,
  "instructions": [
    "worker-instructions.md"
  ],
  "mcp": {},
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "deny"
  },
  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX",
      "options": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "1234"
      },
      "models": {
        "gpt-oss-20b-MXFP4-Q8": {
          "name": "gpt-oss-20b (oMLX)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "Qwen3-Coder-30B-A3B-Instruct-4bit": {
          "name": "Qwen3-Coder-30B-A3B (oMLX)",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "Ternary-Bonsai-2-27B-mlx-2bit": {
          "name": "Ternary-Bonsai-2-27B (2-bit MLX)",
          "tool_call": true,
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    }
  }
}
