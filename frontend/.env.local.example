# Server-only upstream for the /api/v1 Route Handler BFF (issue #1055).
# Never put Docker-internal hosts in NEXT_PUBLIC_* — the browser calls /api/v1.
BACKEND_URL=http://localhost:8080/api/v1

# Browser OpenTelemetry (#1739 / CU77). Layout reads this at request time.
# Browser posts to same-origin /api/otlp/v1/traces (never Docker collector DNS).
# NEXT_PUBLIC_OTEL_TRACES_ENABLED=true
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
