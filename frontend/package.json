    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
