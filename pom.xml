<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.licensis</groupId>
    <artifactId>notaire-root</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Notaire Root</name>

    <!-- The legacy frontend-swing Swing GUI client was deprecated and removed
         from the repository; new client work belongs in frontend/ (Next.js). -->
    <modules>
        <module>backend-api</module>
    </modules>

    <properties>
        <java.version>26</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>26</maven.compiler.source>
        <maven.compiler.target>26</maven.compiler.target>
        <!--
          Security patch overrides of versions managed by spring-boot-starter-parent 4.1.1
          (issue #1327, CU78). Boot 4.1.1 ships tomcat 11.0.24 (CRITICAL CVE-2026-65182,
          CVE-2026-65905, CVE-2026-68525), jackson 2.21.5 and 3.1.5 (HIGH CVE-2026-68497,
          -89407, -89425, -91776, -91777). Each override stays on the line Boot manages.
          Remove an override once the Boot parent manages that version or newer;
          PatchedDependencyFloorTest keeps the floor either way.
        -->
        <tomcat.version>11.0.26</tomcat.version>
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
    </properties>

</project>
