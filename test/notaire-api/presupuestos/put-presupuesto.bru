meta {
  name: Update Presupuesto
  type: http
}

put {
  url: {{base_url}}/api/v1/presupuestos/{{presupuesto_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  numero: 1002
  fecha: "2025-02-01"
  estado: "aprobado"
  observaciones: "Presupuesto actualizado"
}

tests {
  test("Status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  ## Update Presupuesto
  Actualiza un presupuesto existente en el sistema.
  
  **Method:** PUT
  **Path:** /api/v1/presupuestos/{id}
}
