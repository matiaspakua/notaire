meta {
  name: Create Documento Presentado
  type: http
}

post {
  url: {{base_url}}/api/v1/documento-presentado
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  nombre: "Documento de prueba"
  descripcion: "Descripción del documento"
  fechaPresentacion: "2025-01-15"
}

tests {
  test("Status 201 or 200", function () {
    expect([200, 201]).to.include(res.getStatus());
  });
}

docs {
  ## Create Documento Presentado
  Crea un nuevo documento presentado en el sistema.
  
  **Method:** POST
  **Path:** /api/v1/documento-presentado
}
