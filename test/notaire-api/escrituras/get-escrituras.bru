}

tests {
  test("Status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
   
  test("Response is array", function () {
    const body = res.getBody();
    expect(body).to.be.an('array');
  });
}

docs {
  ## Get All Escrituras
  Obtiene todas las escrituras del sistema.
  
  **Method:** GET
