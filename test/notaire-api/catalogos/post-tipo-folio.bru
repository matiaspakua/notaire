}

tests {
  test("Status 201 or 200", function () {
    expect([200, 201]).to.include(res.getStatus());
  });
}

docs {
  ## Create Tipo Folio
  Crea un nuevo tipo de folio en el sistema.
  
  **Method:** POST
  **Path:** /api/v1/tipo-folio
}
