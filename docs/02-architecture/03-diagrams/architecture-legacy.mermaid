graph TD
    subgraph "Legacy Monolith (Java Swing)"
        UI[Java Swing GUI]
        BL[Business Logic Classes]
        DA[JDBC Data Access]
        Rpt[JasperReports Engine]
    end

    UI --> BL
    BL --> DA
    DA --> DB[(MySQL Database)]
    BL --> Rpt
    Rpt --> File[Local PDF Files]

    style UI fill:#f9f,stroke:#333,stroke-width:4px
    style DB fill:#00f,stroke:#333,stroke-width:2px,color:#fff
