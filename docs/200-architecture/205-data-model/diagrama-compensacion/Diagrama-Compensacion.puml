@startuml Diagrama_Compensacion_Escribania
!theme plain
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 60
skinparam shadowing false
skinparam dpi 300

skinparam usecase {
    BackgroundColor #EBF5FB
    BorderColor #2980B9
    FontColor #1A5276
    FontStyle bold
    FontSize 11
}

skinparam rectangle<<rule>> {
    BackgroundColor #FCF3CF
    BorderColor #B7950B
    FontColor #7D6608
    FontSize 10
    FontStyle bold
    roundCorner 4
}

skinparam note {
    BackgroundColor #FDEDEC
    BorderColor #C0392B
    FontColor #78281F
    FontSize 10
}

title **Compensation diagram — Notaire**\nReferential-integrity rules (Insert / Update / Delete)\nColumn names follow Flyway V45. PostgreSQL 16.

' =============================================================================
' LEGEND
' =============================================================================
legend top left
  |= Operation |= Mechanism |= Meaning |
  | **I** (Insert) | **I** (Restrict) | The parent primary key must exist (FK NOT NULL) |
  | | **Null** (Set null) | The child may be recorded without a parent when the FK is nullable |
  | **M** (Update) | **I** (Restrict) | The FK cannot be changed to a primary key that does not exist |
  | | **C** (Cascade) | A primary-key change is copied to every child foreign key |
  | **B** (Delete) | **I** (Restrict) | PostgreSQL's default when no ON DELETE action is declared |
  | | **C** (Cascade) | Deleting the parent deletes the child rows |
  | | **Null** (Set null) | Deleting the parent sets the child foreign key to NULL |
  | **Note** | **V14** | The canonical link is `procedures.fk_id_budget`. `budgets.fk_id_tramite` was removed |
endlegend

' =============================================================================
' ENTITIES
' Numbering matches the Id column of "Diagrama de Compensacion.csv".
' identifications is not drawn. Flyway V1–V44 never create it. See section 6.1.
' =============================================================================
usecase "people" as people
usecase "identification_types" as identification_types
usecase "users" as users
usecase "roles" as roles
usecase "role_modules" as role_modules
usecase "audit_records" as audit_records
usecase "substitutions" as substitutions

usecase "deed_managements" as deed_managements
usecase "management_statuses" as management_statuses
usecase "history" as history
usecase "procedure_types" as procedure_types
usecase "procedures" as procedures
usecase "person_procedures" as person_procedures
usecase "properties" as properties
usecase "workflow_definition" as workflow_definition
usecase "workflow_node" as workflow_node
usecase "workflow_transition" as workflow_transition

usecase "document_types" as document_types
usecase "procedure_templates" as procedure_templates
usecase "submitted_documents" as submitted_documents

usecase "budgets" as budgets
usecase "concepts" as concepts
usecase "budget_templates" as budget_templates
usecase "items" as items
usecase "payments" as payments

usecase "deeds" as deeds
usecase "folio_types" as folio_types
usecase "folios" as folios
usecase "testimonies" as testimonies
usecase "testimony_movements" as testimony_movements
usecase "copies" as copies
usecase "folio_copies" as folio_copies

' =============================================================================
' COMPENSATION RULES
' =============================================================================

' 3. people -> users
rectangle "I: I\nM: I\nB: I" as r_people_users <<rule>>
people -down- r_people_users
r_people_users -down-> users

' 4. roles -> users
rectangle "I: Null\nM: I\nB: Null" as r_roles_users <<rule>>
roles -down- r_roles_users
r_roles_users -down-> users

' 5. roles -> role_modules
rectangle "I: I\nM: I\nB: C" as r_roles_modules <<rule>>
roles -down- r_roles_modules
r_roles_modules -down-> role_modules

' 6. users -> audit_records
rectangle "I: I\nM: I\nB: I" as r_users_audit <<rule>>
users -down- r_users_audit
r_users_audit -down-> audit_records

' 7. people -> substitutions (substituted / substitute)
rectangle "I: I\nM: I\nB: I" as r_people_substitutions <<rule>>
people -down- r_people_substitutions
r_people_substitutions -down-> substitutions

' 8. workflow_definition -> workflow_node
rectangle "I: I\nM: I\nB: C" as r_wf_node <<rule>>
workflow_definition -down- r_wf_node
r_wf_node -down-> workflow_node

' 9. workflow_definition -> workflow_transition
rectangle "I: I\nM: I\nB: C" as r_wf_transition <<rule>>
workflow_definition -down- r_wf_transition
r_wf_transition -down-> workflow_transition

' 10. management_statuses -> workflow_node
rectangle "I: I\nM: I\nB: I" as r_status_node <<rule>>
management_statuses -down- r_status_node
r_status_node -down-> workflow_node

' 11. workflow_node -> workflow_transition
rectangle "I: I\nM: I\nB: C" as r_node_transition <<rule>>
workflow_node -down- r_node_transition
r_node_transition -down-> workflow_transition

' 12. workflow_definition -> procedure_types
rectangle "I: Null\nM: I\nB: I" as r_wf_procedure_type <<rule>>
workflow_definition -down- r_wf_procedure_type
r_wf_procedure_type -down-> procedure_types
note right of r_wf_procedure_type
  The column is nullable. Deleting the workflow
  stays restricted by PostgreSQL's default.
end note

' 13. people (notary) -> deed_managements
rectangle "I: I\nM: I\nB: I" as r_people_managements <<rule>>
people -down- r_people_managements
r_people_managements -down-> deed_managements

' 14. management_statuses -> deed_managements
rectangle "I: Null\nM: I\nB: Null" as r_status_managements <<rule>>
management_statuses -down- r_status_managements
r_status_managements -down-> deed_managements

' 15. deed_managements -> history
rectangle "I: I\nM: I\nB: C" as r_managements_history <<rule>>
deed_managements -down- r_managements_history
r_managements_history -down-> history

' 16. management_statuses -> history
rectangle "I: I\nM: I\nB: I" as r_status_history <<rule>>
management_statuses -down- r_status_history
r_status_history -down-> history

' 17. procedure_types -> procedure_templates
rectangle "I: I\nM: I\nB: I" as r_procedure_type_templates <<rule>>
procedure_types -down- r_procedure_type_templates
r_procedure_type_templates -down-> procedure_templates

' 18. document_types -> procedure_templates
rectangle "I: I\nM: I\nB: C" as r_document_type_templates <<rule>>
document_types -down- r_document_type_templates
r_document_type_templates -down-> procedure_templates

' 19. procedure_types -> budget_templates
rectangle "I: I\nM: I\nB: C" as r_procedure_type_budget_templates <<rule>>
procedure_types -down- r_procedure_type_budget_templates
r_procedure_type_budget_templates -down-> budget_templates

' 20. concepts -> budget_templates
rectangle "I: I\nM: I\nB: C" as r_concepts_budget_templates <<rule>>
concepts -down- r_concepts_budget_templates
r_concepts_budget_templates -down-> budget_templates

' 21. people -> budgets
rectangle "I: I\nM: I\nB: I" as r_people_budgets <<rule>>
people -down- r_people_budgets
r_people_budgets -down-> budgets

' 22. budgets -> items
rectangle "I: I\nM: I\nB: C" as r_budgets_items <<rule>>
budgets -down- r_budgets_items
r_budgets_items -down-> items

' 23. budgets -> payments
rectangle "I: I\nM: I\nB: I" as r_budgets_payments <<rule>>
budgets -down- r_budgets_payments
r_budgets_payments -down-> payments
note right of r_budgets_payments
  Payments cannot exist without a budget.
  Do not delete a budget that has payments.
end note

' 24. budgets -> procedures (Flyway V14: canonical link is procedures.fk_id_budget)
rectangle "I: I\nM: I\nB: I" as r_budgets_procedures <<rule>>
budgets -down- r_budgets_procedures
r_budgets_procedures -down-> procedures
note right of r_budgets_procedures
  V14: the redundant foreign key on budgets was removed.
  The live link is procedures.fk_id_budget.
end note

' 25. procedure_types -> procedures
rectangle "I: I\nM: I\nB: I" as r_procedure_type_procedures <<rule>>
procedure_types -down- r_procedure_type_procedures
r_procedure_type_procedures -down-> procedures

' 26. deed_managements -> procedures
rectangle "I: Null\nM: I\nB: Null" as r_managements_procedures <<rule>>
deed_managements -down- r_managements_procedures
r_managements_procedures -down-> procedures
note right of r_managements_procedures
  Protocolo Auxiliar may have
  no deed-management folder.
end note

' 27. deeds -> procedures
rectangle "I: Null\nM: I\nB: Null" as r_deeds_procedures <<rule>>
deeds -down- r_deeds_procedures
r_deeds_procedures -down-> procedures
note right of r_deeds_procedures
  The procedure starts without a deed.
  The deed is assigned when the act is granted.
end note

' 28. properties -> procedures
rectangle "I: Null\nM: I\nB: Null" as r_properties_procedures <<rule>>
properties -down- r_properties_procedures
r_properties_procedures -down-> procedures
note right of r_properties_procedures
  Procedures with no property
  have a null foreign key.
end note

' 29. procedures -> person_procedures
rectangle "I: I\nM: I\nB: C" as r_procedures_parties <<rule>>
procedures -down- r_procedures_parties
r_procedures_parties -down-> person_procedures

' 30. people -> person_procedures
rectangle "I: I\nM: I\nB: I" as r_people_parties <<rule>>
people -down- r_people_parties
r_people_parties -down-> person_procedures

' 31. procedures -> submitted_documents (Flyway V6)
rectangle "I: Null\nM: I\nB: C" as r_procedures_documents <<rule>>
procedures -down- r_procedures_documents
r_procedures_documents -down-> submitted_documents
note right of r_procedures_documents
  V6: autonomous documents are allowed
  before a procedure is assigned.
end note

' 32. document_types -> submitted_documents
rectangle "I: Null\nM: I\nB: I" as r_document_type_documents <<rule>>
document_types -down- r_document_type_documents
r_document_type_documents -down-> submitted_documents

' 33. people (notary) -> folios
rectangle "I: I\nM: I\nB: I" as r_people_folios <<rule>>
people -down- r_people_folios
r_people_folios -down-> folios

' 34. folio_types -> folios
rectangle "I: I\nM: I\nB: I" as r_folio_type_folios <<rule>>
folio_types -down- r_folio_type_folios
r_folio_type_folios -down-> folios

' 35. deeds -> folios
rectangle "I: Null\nM: I\nB: Null" as r_deeds_folios <<rule>>
deeds -down- r_deeds_folios
r_deeds_folios -down-> folios
note right of r_deeds_folios
  Folios that are available, or stored as "Errose / No Pasó",
  have no deed assigned.
end note

' 36. deeds -> testimonies
rectangle "I: I\nM: I\nB: C" as r_deeds_testimonies <<rule>>
deeds -down- r_deeds_testimonies
r_deeds_testimonies -down-> testimonies

' 37. testimonies -> testimony_movements
rectangle "I: I\nM: I\nB: C" as r_testimonies_movements <<rule>>
testimonies -down- r_testimonies_movements
r_testimonies_movements -down-> testimony_movements

' 38. testimonies -> copies
rectangle "I: I\nM: I\nB: C" as r_testimonies_copies <<rule>>
testimonies -down- r_testimonies_copies
r_testimonies_copies -down-> copies
note right of r_testimonies_copies
  Copies that were not picked up,
  or that were issued by mistake, are deleted.
end note

' 39. people -> copies
rectangle "I: I\nM: I\nB: I" as r_people_copies <<rule>>
people -down- r_people_copies
r_people_copies -down-> copies

' 40. folios -> folio_copies
rectangle "I: I\nM: I\nB: I" as r_folios_folio_copies <<rule>>
folios -down- r_folios_folio_copies
r_folios_folio_copies -down-> folio_copies

' 41. copies -> folio_copies
rectangle "I: I\nM: I\nB: C" as r_copies_folio_copies <<rule>>
copies -down- r_copies_folio_copies
r_copies_folio_copies -down-> folio_copies

@enduml
