@startuml
title Core Domain Model — Notaire

entity "DeedManagement" as management {
  * id : Long <<PK>>
  --
  number : String
  date : Date
  status_id : Long <<FK>>
  deed_id : Long <<FK>>
  workflow_id : Long <<FK>>
}

entity "Deed" as deed {
  * id : Long <<PK>>
  --
  number : Integer
  date : Date
}

entity "Person" as person {
  * id : Long <<PK>>
  --
  name : String
  last_name : String
  dni : String
  email : String
}

entity "Budget" as budget {
  * id : Long <<PK>>
  --
  amount : BigDecimal
  date : Date
}

entity "Procedure" as procedure {
  * id : Long <<PK>>
  --
  name : String
  number : String
  procedure_type_id : Long <<FK>>
}

entity "ProcedureType" as procedureType {
  * id : Long <<PK>>
  --
  name : String
  workflow_id : Long <<FK>>
}

entity "Folio" as folio {
  * id : Long <<PK>>
  --
  number : String
  type_id : Long <<FK>>
}

entity "Payment" as payment {
  * id : Long <<PK>>
  --
  amount : BigDecimal
  date : Date
}

entity "Testimony" as testimony {
  * id : Long <<PK>>
}

entity "SubmittedDocument" as doc {
  * id : Long <<PK>>
}

entity "User" as user {
  * id : Long <<PK>>
  --
  username : String
  password : String (BCrypt)
}

entity "Role" as role {
  * id : Long <<PK>>
  --
  name : String
}

entity "AuditRecord" as audit {
  * id : Long <<PK>>
  --
  action : String
  module : String
  user : String
  timestamp : Timestamp
}

entity "WorkflowDefinition" as wfDef {
  * id : Long <<PK>>
  --
  name : String
}

entity "WorkflowNode" as wfNode {
  * id : Long <<PK>>
  --
  name : String
  node_type : NodeType
}

entity "WorkflowTransition" as wfTrans {
  * id : Long <<PK>>
  --
  from_node_id : Long <<FK>>
  to_node_id : Long <<FK>>
}

management ||--o{ procedure
management ||--o{ budget
management }o--|| deed
management ||--o{ folio
management ||--o{ doc
procedure }o--|| procedureType
procedure }o--o{ person
budget ||--o{ payment
deed ||--o{ testimony
user }o--|| role
user ||--o{ audit
wfDef ||--o{ wfNode
wfDef ||--o{ wfTrans
procedureType }o--o| wfDef
@enduml
