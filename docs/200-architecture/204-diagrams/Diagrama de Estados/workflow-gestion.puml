@startuml
title Workflow — Create a new deed management

participant "Notary (Escribano)" as User
participant "Frontend\n(Swing / Web)" as Client
participant "REST API\n(Spring Boot)" as API
participant "Spring Security" as Sec
participant "ManagementController" as Ctrl
participant "Business Service" as Svc
participant "PostgreSQL" as DB

User -> Client : Start a new management
Client -> API : POST /api/v1/managements
API -> Sec : Validate the JWT
Sec --> API : OK (user context)
API -> Ctrl : delegateRequest(dto)
Ctrl -> Svc : create(request)
Svc -> Svc : Validate business data
Svc -> DB : INSERT INTO deed_managements
DB --> Svc : OK (generatedId)
Svc -> DB : INSERT INTO audit_records
DB --> Svc : OK
Svc --> Ctrl : created management
Ctrl --> API : 201 Created
API --> Client : JSON response
Client --> User : Show success and the number
@enduml
