@startuml
title Create a management — POST /api/v1/managements/complete-case

skinparam shadowing false

participant "Notary (Escribano)" as User
participant "Frontend" as Client
participant "REST API" as API
participant "ManagementController" as Ctrl
participant "Workflow" as WF
participant "PostgreSQL" as DB

User -> Client : Start the management with a budget
Client -> API : POST /api/v1/managements/complete-case
API -> Ctrl : completeCase(dto)
Ctrl -> WF : The status is an INITIAL node
alt The procedure type has a workflow and the status is initial
  WF --> Ctrl : Iniciada
  Ctrl -> DB : INSERT INTO deed_managements
  DB --> Ctrl : id
  Ctrl --> API : 201 Created
  API --> Client : JSON
  Client --> User : Management number
else The status is not initial
  Ctrl --> API : 400
  API --> Client : The management is not created
end
@enduml
