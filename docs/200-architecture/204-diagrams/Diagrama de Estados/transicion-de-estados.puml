' Actividad del trámite, alineada al workflow sembrado (V10 + V41) y a
' docs/200-architecture/203-design/GESTION.md.
' No es la fuente de verdad de los estados (ADR-027). Esa es CICLO-DE-VIDA.md §3.1.
' La firma de la escritura y la minuta no son aristas de esta actividad.
@startuml
title Actividad — trámite de una gestión

skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F6EBD8
  BorderColor #333333
  FontColor #111111
  DiamondBackgroundColor #F6EBD8
  DiamondBorderColor #333333
}

start

:Cliente solicita un trámite;
:Gestor identifica cliente y presupuesto\n(CU61, CU60, CU01);
:POST /api/v1/managements/complete-case;
:Gestión en Iniciada;

:Transición «Se asignan trámites»;
:En Tramite;

:Documentación del cliente y de entidades externas\n(CU04, CU10);
:Transición «Documentación presentada»;
:Documentacion Completa;

if (¿Archivar sin escritura?) then (sí)
  :POST /api/v1/managements/{id}/archive;
  if (¿Carpeta en Espera sin confirmar?) then (sí)
    :409 — la gestión no cambia;
    stop
  else (no)
    :Saldo mayor a cero: advertencia, no bloquea;
    :Archivada;
    stop
  endif
else (seguir con la escritura)
endif

:Transición «Se redacta la escritura»;
:Gestion con Escritura Sin Firmar;

note right
  POST /api/v1/deeds/{id}/sign
  cambia deeds.status a Firmada.
  No mueve este nodo.
end note

:Transición «Las partes firman»;
:Gestion con Escritura Firmada;

:Transición «Se genera el testimonio»;
:Testimonio Generado;

:Transición «Ingreso a inscripción»;
:Testimonio Ingresado a Inscripcion;

:Transición «Retiro»;
:Testimonio Retirado;
stop
@enduml
