@startuml
title Management state transition

skinparam shadowing true
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F6EBD8
  BorderColor #333333
  FontColor #111111
  DiamondBackgroundColor #F6EBD8
  DiamondBorderColor #333333
}

start

:Request to start a management;

if (Is the person a client?) then (yes)
  :Find the client;
else (no)
  if (Does the person need to be created?) then (yes)
    :Create the person;
  endif
  :Create the client;
endif

if (Does a budget exist?) then (yes)
  :Find the budget;
else (no)
  :Create the budget;
endif

:Start the management;

repeat
  :Waiting for documents;
repeat while (Are the documents complete?) is (no) not (yes)

repeat
  :Prepare the deed;

  if (Deed result) then (sign)
    :Sign the deed;
    :Generate the testimony;

    if (Does it require registration?) then (yes)
      :Submit for registration;

      while (Did it return Observado?) is (yes)
        :Record the re-entry;
        :Submit for registration;
      endwhile (no)
    endif

    repeat
      :Withdraw the testimony;
    repeat while (Have all testimonies been withdrawn?) is (no) not (yes)
  elseif (void)
    :Deed voided;
  else (No Pasó)
    :Deed status No Pasó;
  endif

repeat while (Are there more procedures in the management?) is (yes) not (no)

if (Is the pending balance > 0?) then (yes)
  :Show the pending-debt warning (it does not block);
endif

:Archive the management;
stop
@enduml
