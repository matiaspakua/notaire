@startuml login-wrong-password
!theme plain
title TC-LOGIN-02: Wrong Password Returns valido=false

actor "User" as User
participant "Frontend" as FE
participant "UsuarioController" as Ctrl
participant "LoginAttemptService" as LAS
participant "UsuarioRepository" as Repo
participant "PasswordEncoder" as PE

User -> FE: Enter credentials (nombre, wrong contrasenia)
FE -> Ctrl: POST /api/v1/usuarios/login
activate Ctrl

Ctrl -> LAS: isLocked(nombre)
activate LAS
LAS --> Ctrl: false
deactivate LAS

Ctrl -> Repo: findAll()
activate Repo
Repo --> Ctrl: List<Usuario>
deactivate Repo

Ctrl -> Ctrl: Find user by nombre
activate Ctrl
Ctrl -> PE: matches(contrasenia, usuario)
activate PE
PE --> Ctrl: false
deactivate PE
deactivate Ctrl

Ctrl -> LAS: onLoginFailed(nombre)
activate LAS
LAS --> Ctrl: void (increments failed count)
deactivate LAS

Ctrl --> FE: 200 OK {valido: false}
deactivate Ctrl

FE -> User: Show "Invalid credentials" message

@enduml
