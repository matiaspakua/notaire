@startuml login-wrong-password
!theme plain
title TC-LOGIN-02: Wrong Password Returns valid=false

actor "User" as User
participant "Frontend" as FE
participant "UserController" as Ctrl
participant "LoginAttemptService" as LAS
participant "UserRepository" as Repo
participant "PasswordEncoder" as PE

User -> FE: Enter credentials (name, wrong password)
FE -> Ctrl: POST /api/v1/users/login
activate Ctrl

Ctrl -> LAS: isLocked(name)
activate LAS
LAS --> Ctrl: false
deactivate LAS

Ctrl -> Repo: findAll()
activate Repo
Repo --> Ctrl: List<User>
deactivate Repo

Ctrl -> Ctrl: Find user by name
activate Ctrl
Ctrl -> PE: matches(password, user)
activate PE
PE --> Ctrl: false
deactivate PE
deactivate Ctrl

Ctrl -> LAS: onLoginFailed(name)
activate LAS
LAS --> Ctrl: void (increments failed count)
deactivate LAS

Ctrl --> FE: 200 OK {valid: false}
deactivate Ctrl

FE -> User: Show "Invalid credentials" message

@enduml
