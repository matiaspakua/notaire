@startuml actores
!theme plain
title Actors of the Notaire system

actor Person
actor Client
actor Escribano
actor "Receptionist / Clerk (Gestor)" as ReceptionistClerk
actor Administrator

Client --|> Person
Escribano --|> Person
ReceptionistClerk --|> Person
Administrator --|> Person

note right of Person
  Abstract actor: groups the attributes and
  use cases shared by every person
  registered in the system. Client,
  Escribano, Receptionist/Clerk (Gestor), and
  Administrator specialize Person.
end note

@enduml
