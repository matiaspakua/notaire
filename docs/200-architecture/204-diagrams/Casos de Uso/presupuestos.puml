@startuml presupuestos
!theme plain
left to right direction
title Use cases — Budget module

actor "Receptionist / Clerk (Gestor)" as ReceptionistClerk
actor Person

rectangle "Budget module" {
  usecase "CU01 - Preparar Presupuesto" as CU01
  usecase "CU60 - Buscar Presupuesto" as CU60
  usecase "CU45 - Modificar presupuesto" as CU45
}

usecase "CU64 - Buscar Tipo de trámite\n(from Trámites)" as CU64
usecase "CU61 - Buscar persona o cliente\n(from Clientes)" as CU61

ReceptionistClerk --> CU01 : prepares
ReceptionistClerk --> CU60 : looks up / needs
ReceptionistClerk --> CU45 : needs
Person --> CU01 : provides data
Person --> CU45 : provides data

CU01 ..> CU64 : <<include>>
CU01 ..> CU61 : <<include>>
CU60 ..> CU61 : <<include>>
CU45 ..> CU60 : <<include>>

@enduml
