@startuml administracion-escribanos
!theme plain
left to right direction
title Use cases — Notaries module (Administration)

actor Administrator
actor Escribano
actor "Receptionist / Clerk (Gestor)" as ReceptionistClerk

rectangle "Notaries module" {
  usecase "CU48 - Dar alta escribano" as CU48
  usecase "CU51 - Modificar escribano" as CU51
  usecase "CU22 - Registrar Suplencia" as CU22
  usecase "CU59 - Consultar Suplencias" as CU59
}

usecase "CU61 - Buscar persona o cliente\n(from Clients)" as CU61

Administrator --> CU48 : needs
Administrator --> CU51 : needs
Escribano --> CU51 : needs
Escribano --> CU22 : requests
Escribano --> CU59 : requests
ReceptionistClerk --> CU59 : requests

CU48 ..> CU61 : <<include>>
CU51 ..> CU61 : <<include>>
CU22 ..> CU61 : <<include>>
CU59 ..> CU61 : <<include>>

@enduml
