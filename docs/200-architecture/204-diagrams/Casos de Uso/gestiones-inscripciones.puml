@startuml gestiones-inscripciones
!theme plain
left to right direction
title Use cases — Registration module

actor Escribano
actor "Receptionist / Clerk (Gestor)" as ReceptionistClerk

rectangle "Registration module" {
  usecase "CU11 - Ingresar para inscripción" as CU11
  usecase "CU56 - Registrar inscripción" as CU56
  usecase "CU44 - Reingresar testimonio" as CU44
}

usecase "CU62 - Buscar Escritura\n(from Deeds)" as CU62

Escribano --> CU11 : records
Escribano --> CU56 : records
ReceptionistClerk --> CU56 : needs
ReceptionistClerk --> CU44 : records

CU11 ..> CU62 : <<include>>
CU56 ..> CU62 : <<include>>
CU44 ..> CU62 : <<include>>

@enduml
