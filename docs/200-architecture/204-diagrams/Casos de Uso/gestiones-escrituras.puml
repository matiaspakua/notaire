@startuml gestiones-escrituras
!theme plain
left to right direction
title Use cases — Deeds module

actor Escribano
actor Client
actor "Receptionist / Clerk (Gestor)" as ReceptionistClerk

rectangle "Deeds module" {
  usecase "CU05 - Preparar escritura" as CU05
  usecase "CU06 - Firmar escritura" as CU06
  usecase "CU62 - Buscar Escritura" as CU62
  usecase "CU52 - Modificar Escritura" as CU52
}

usecase "CU19 - Buscar gestiones de un Cliente\n(from Clientes)" as CU19
usecase "CU63 - Buscar Folios\n(from Folios)" as CU63

Escribano --> CU05 : prepares
Escribano --> CU06 : needs
Escribano --> CU62 : needs
Client --> CU05 : provides data
Client --> CU06 : takes part
Client --> CU52 : takes part
ReceptionistClerk --> CU62 : needs
ReceptionistClerk --> CU52 : needs

CU05 ..> CU19 : <<include>>
CU05 ..> CU06 : <<extend>>
CU52 ..> CU62 : <<include>>
CU52 ..> CU63 : <<include>>

@enduml
