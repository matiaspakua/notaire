@startuml gestiones-gestion
!theme plain
left to right direction
title Use cases — Management module

actor "Receptionist / Clerk (Gestor)" as ReceptionistClerk
actor Escribano
actor Client

rectangle "Management module" {
  usecase "CU02 - Iniciar Gestión" as CU02
  usecase "CU53 - Modificar Gestión" as CU53
  usecase "CU13 - Ver historial de gestión" as CU13
  usecase "CU16 - Archivar Gestión" as CU16
}

usecase "CU60 - Buscar Presupuesto\n(from Budget)" as CU60
usecase "CU19 - Buscar gestiones de un Cliente\n(from Clients)" as CU19

ReceptionistClerk --> CU02 : indicates
ReceptionistClerk --> CU53 : needs
ReceptionistClerk --> CU13 : needs
Escribano --> CU13 : needs
Escribano --> CU16 : needs
Client --> CU02 : requests
Client --> CU53 : requests

CU02 ..> CU60 : <<include>>
CU53 ..> CU19 : <<include>>
CU13 ..> CU19 : <<include>>

@enduml
