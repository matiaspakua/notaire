@startuml clientes
!theme plain
left to right direction
title Use cases — Clients module

actor "Receptionist / Clerk (Gestor)" as ReceptionistClerk
actor Escribano
actor Person
actor Client

rectangle "Clients module" {
  usecase "CU17 - Dar Alta persona" as CU17
  usecase "CU54 - Modificar Persona" as CU54
  usecase "CU18 - Dar Alta Cliente" as CU18
  usecase "CU41 - Modificar Cliente" as CU41
  usecase "CU46 - Ver detalle cliente" as CU46
  usecase "CU61 - Buscar persona o cliente" as CU61
  usecase "CU19 - Buscar gestiones de un Cliente" as CU19
}

ReceptionistClerk --> CU17 : requests
ReceptionistClerk --> CU18 : requests
ReceptionistClerk --> CU41 : needs
ReceptionistClerk --> CU46 : needs
Escribano --> CU46 : needs
Escribano --> CU19 : requests

Person --> CU17 : provides data
Person --> CU54 : provides data
Person --> CU18 : provides data
Client --> CU41 : provides data
Client --> CU61 : requests
Client --> CU19 : requests

CU18 ..> CU61 : <<include>>
CU54 ..> CU61 : <<include>>
CU41 ..> CU61 : <<include>>
CU46 ..> CU61 : <<include>>
CU19 ..> CU61 : <<include>>

@enduml
