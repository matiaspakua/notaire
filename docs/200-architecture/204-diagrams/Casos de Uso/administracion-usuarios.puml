@startuml administracion-usuarios
!theme plain
left to right direction
title Use cases — Users module (Administration)

actor Escribano

rectangle "Users module" {
  usecase "CU20 - Dar alta usuario" as CU20
  usecase "CU21 - Modificar Usuario" as CU21
  usecase "CU23 - Ver registro de actividades de usuario" as CU23
}

usecase "CU61 - Buscar persona o cliente\n(from Clientes)" as CU61

Escribano --> CU20 : needs
Escribano --> CU21 : needs
Escribano --> CU23 : needs

CU20 ..> CU61 : <<include>>
CU21 ..> CU61 : <<include>>
CU23 ..> CU61 : <<include>>

@enduml
