@startuml gestiones-testimonios
!theme plain
left to right direction
title Use cases — Testimonies module

actor Escribano
actor "Receptionist / Clerk (Gestor)" as ReceptionistClerk
actor Client

rectangle "Testimonies module" {
  usecase "CU07 - Generar testimonio" as CU07
  usecase "CU08 - Verificar Testimonio" as CU08
  usecase "CU12 - Retirar testimonio" as CU12
}

usecase "CU62 - Buscar Escritura\n(from Escrituras)" as CU62

Escribano --> CU07 : needs
Escribano --> CU08 : needs
ReceptionistClerk --> CU12 : records
Client --> CU12 : requests

CU07 ..> CU62 : <<include>>
CU08 ..> CU62 : <<include>>
CU12 ..> CU62 : <<include>>

@enduml
