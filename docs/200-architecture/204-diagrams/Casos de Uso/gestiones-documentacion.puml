@startuml gestiones-documentacion
!theme plain
left to right direction
title Use cases — Documentation module

actor "Receptionist / Clerk (Gestor)" as ReceptionistClerk
actor Escribano
actor Client
actor Person

rectangle "Documentation module" {
  usecase "CU42 - Informar próximos vencimientos" as CU42
  usecase "CU04 - Registrar documentación cliente" as CU04
  usecase "CU03 - Lista documentos y certificados necesarios" as CU03
  usecase "CU09 - Registrar deudas documentos de Cliente" as CU09
  usecase "CU10 - Registrar movimientos de documentación de entidades externas" as CU10
  usecase "CU43 - Reingresar documentación" as CU43
}

usecase "CU19 - Buscar gestiones de un Cliente\n(from Clientes)" as CU19

ReceptionistClerk --> CU42 : is informed
ReceptionistClerk --> CU04 : records
ReceptionistClerk --> CU03 : requests
ReceptionistClerk --> CU09 : needs

Escribano --> CU42 : is informed
Escribano --> CU09 : records
Escribano --> CU10 : needs
Escribano --> CU43 : records

Client --> CU04 : hands over
Client --> CU03 : needs
Person --> CU03 : needs

CU04 ..> CU19 : <<include>>
CU09 ..> CU19 : <<include>>
CU10 ..> CU19 : <<include>>
CU43 ..> CU19 : <<include>>

@enduml
