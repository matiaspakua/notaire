@startuml ERD_Escribania_Actualizado
!theme plain
skinparam linetype ortho
skinparam roundcorner 5
skinparam shadowing false
skinparam class {
    BackgroundColor White
    ArrowColor #2C3E50
    BorderColor #34495E
}

' =============================================================================
' SISTEMA DE GESTIÓN NOTARIAL (NOTAIRE) - MODELO ENTIDAD RELACIÓN ACTUALIZADO (3FN)
' Alineado con PostgreSQL 16 y Flyway Migrations (V1 a V14)
' =============================================================================

package "Sujetos, Identificación y Seguridad" {

  entity "personas" as personas {
    * id_persona : INT <<PK, generated>>
    --
    * nombre : VARCHAR(100)
    * apellido : VARCHAR(100)
    numero_identificacion : VARCHAR(50)
    cuit : VARCHAR(30)
    nacionalidad : VARCHAR(50)
    sexo : VARCHAR(20)
    fecha_nacimiento : DATE
    estado_civil : VARCHAR(50)
    numero_nupcias : INT
    ocupacion : VARCHAR(100)
    profesion : VARCHAR(100)
    domicilio : VARCHAR(255)
    localidad : VARCHAR(100)
    provincia : VARCHAR(100)
    telefono : VARCHAR(50)
    celular : VARCHAR(50)
    email : VARCHAR(100)
    e_mail : VARCHAR(100)
    registro_escribano : INT
    * es_escribano : BOOLEAN
    * es_cliente : BOOLEAN
    observaciones : TEXT
    fk_id_tipo_identificacion : INT <<FK>>
    version : INT
  }

  entity "tipos_identificacion" as tipos_identificacion {
    * id_tipo_identificacion : INT <<PK, generated>>
    --
    * nombre : VARCHAR(50)
    * caracteres : VARCHAR(50)
    version : INT
  }

  entity "identificaciones" as identificaciones {
    * fk_id_tipo_identificacion : INT <<PK, FK>>
    * fk_id_persona : INT <<PK, FK>>
    --
    * numero : VARCHAR(50)
  }

  entity "usuarios" as usuarios {
    * id_usuario : INT <<PK, generated>>
    --
    * nombre : VARCHAR(50)
    * contrasenia : VARCHAR(255)
    * estado : BOOLEAN
    * tipo : VARCHAR(50)
    * fk_id_persona : INT <<FK>>
    fk_id_rol : INT <<FK>>
    version : INT
  }

  entity "roles" as roles {
    * id_rol : INT <<PK, generated>>
    --
    * nombre : VARCHAR(50) <<UNIQUE>>
    descripcion : TEXT
    * activo : BOOLEAN
    version : INT
  }

  entity "roles_permisos" as roles_permisos {
    * fk_id_rol : INT <<PK, FK>>
    * modulo : VARCHAR(100) <<PK>>
  }

  entity "registro_auditoria" as registro_auditoria {
    * id_registro_auditoria : INT <<PK, generated>>
    --
    * fecha : TIMESTAMP
    * modulo : VARCHAR(100)
    * detalle_operacion : TEXT
    * fk_id_usuario : INT <<FK>>
    version : INT
  }

  entity "suplencias" as suplencias {
    * id_suplencia : INT <<PK, generated>>
    --
    * fecha_inicio : DATE
    fecha_fin : DATE
    observaciones : TEXT
    * fk_id_suplantado : INT <<FK>>
    * fk_id_suplente : INT <<FK>>
    version : INT
  }

}

package "Gestión Notarial, Estados y Workflows" {

  entity "estados_de_gestion" as estados_de_gestion {
    * id_estado_gestion : INT <<PK, generated>>
    --
    * nombre : VARCHAR(50)
    observaciones : TEXT
    version : INT
  }

  entity "workflow_definition" as workflow_definition {
    * id_workflow_definition : INT <<PK, generated>>
    --
    * nombre : VARCHAR(100)
    descripcion : TEXT
    * activo : BOOLEAN
    version : INT
  }

  entity "workflow_node" as workflow_node {
    * id_workflow_node : INT <<PK, generated>>
    --
    * fk_workflow_definition_id : INT <<FK>>
    * fk_estado_gestion_id : INT <<FK>>
    * tipo : VARCHAR(20) <<INITIAL | INTERMEDIATE | FINAL>>
    posicion_x : REAL
    posicion_y : REAL
    version : INT
  }

  entity "workflow_transition" as workflow_transition {
    * id_workflow_transition : INT <<PK, generated>>
    --
    * fk_workflow_definition_id : INT <<FK>>
    * fk_nodo_origen_id : INT <<FK>>
    * fk_nodo_destino_id : INT <<FK>>
    condicion : TEXT
    descripcion : TEXT
    version : INT
  }

  entity "gestiones_de_escrituras" as gestiones_de_escrituras {
    * id_gestion : INT <<PK, generated>>
    --
    * numero : INT
    * fecha_inicio : DATE
    * encabezado : VARCHAR(255)
    observaciones : TEXT
    numero_bibliorato : INT
    numero_archivo : INT
    * fk_id_persona_escribano : INT <<FK>>
    fk_id_estado_de_gestion : INT <<FK>>
    version : INT
  }

  entity "historial" as historial {
    * id_historial : INT <<PK, generated>>
    --
    * fecha : TIMESTAMP
    observaciones : TEXT
    * fk_id_gestion : INT <<FK>>
    * fk_id_estado_gestion : INT <<FK>>
    version : INT
  }

  entity "tipos_de_tramite" as tipos_de_tramite {
    * id_tipo_tramite : INT <<PK, generated>>
    --
    * nombre : VARCHAR(100)
    * se_archiva : BOOLEAN
    * se_inscribe : BOOLEAN
    * asocia_inmuebles : BOOLEAN
    * habilitado : BOOLEAN
    observaciones : TEXT
    fk_workflow_definition_id : INT <<FK>>
    version : INT
  }

  entity "tramites" as tramites {
    * id_tramite : INT <<PK, generated>>
    --
    numero : INT
    nombre : VARCHAR(200)
    observaciones : TEXT
    * fk_id_tipo_tramite : INT <<FK>>
    fk_id_gestion : INT <<FK>>
    fk_id_escritura : INT <<FK>>
    * fk_id_presupuesto : INT <<FK>>
    fk_id_inmueble : INT <<FK>>
    version : INT
  }

  entity "tramites_personas" as tramites_personas {
    * fk_id_tramite : INT <<PK, FK>>
    * fk_id_persona_cliente : INT <<PK, FK>>
    --
    * observaciones : VARCHAR(255)
    version : INT
  }

  entity "inmuebles" as inmuebles {
    * id_inmueble : INT <<PK, generated>>
    --
    * nomenclatura : VARCHAR(100)
    matricula : VARCHAR(50)
    valuacion_anio : INT
    valuacion_fiscal : REAL
    partida : INT
    circunscripcion : VARCHAR(20)
    seccion : VARCHAR(20)
    zona : VARCHAR(20)
    manzana : VARCHAR(20)
    parcela : VARCHAR(20)
    poligono : VARCHAR(20)
    unidad_funcional : VARCHAR(20)
    * domicilio : VARCHAR(255)
    localidad : VARCHAR(100)
    tipo_inmueble : VARCHAR(50)
    observaciones : TEXT
    version : INT
  }

}

package "Documentación y Certificados" {

  entity "tipos_de_documento" as tipos_de_documento {
    * id_tipo_documento : INT <<PK, generated>>
    --
    * nombre : VARCHAR(150)
    * devuelto : BOOLEAN
    * vence : BOOLEAN
    dias_vencimiento : INT
    importe_a_pagar : REAL
    * habilitado : BOOLEAN
    * quien_entrega : VARCHAR(50)
    version : INT
  }

  entity "plantilla_tramites" as plantilla_tramites {
    * fk_id_tipo_tramite : INT <<PK, FK>>
    * fk_id_tipo_documento : INT <<PK, FK>>
    --
    observaciones : TEXT
    version : INT
  }

  entity "documentos_presentados" as documentos_presentados {
    * id_documento_presentado : INT <<PK, generated>>
    --
    * nombre : VARCHAR(150)
    numero_carton : INT
    fecha_ingreso : DATE
    fecha_salida : DATE
    * preparado : BOOLEAN
    * vence : BOOLEAN
    fecha_vencimiento : DATE
    dias_vencimiento : INT
    importe_a_pagar : REAL
    fecha_pago : DATE
    * liberado : BOOLEAN
    fecha_liberado : DATE
    * observado : BOOLEAN
    observaciones : TEXT
    entregado : BOOLEAN
    reingresado : BOOLEAN
    * quien_entrega : VARCHAR(50)
    fk_id_tramite : INT <<FK>>
    fk_id_tipo_documento : INT <<FK>>
    version : INT
  }

}

package "Presupuestación y Cobranzas" {

  entity "conceptos" as conceptos {
    * id_concepto : INT <<PK, generated>>
    --
    * nombre : VARCHAR(150)
    * valor : REAL
    * porcentaje : INT
    * habilitado : BOOLEAN
    * concepto_fijo : BOOLEAN
    version : INT
  }

  entity "plantilla_presupuestos" as plantilla_presupuestos {
    * fk_id_tipo_tramite : INT <<PK, FK>>
    * fk_id_concepto : INT <<PK, FK>>
    --
    observaciones : TEXT
    version : INT
  }

  entity "presupuestos" as presupuestos {
    * id_presupuesto : INT <<PK, generated>>
    --
    * numero : INT
    * fecha : DATE
    * encabezado : VARCHAR(255)
    * total : REAL
    * saldo : REAL
    * estado : VARCHAR(50)
    monto_inmueble : REAL
    observaciones : TEXT
    * fk_id_persona : INT <<FK>>
    version : INT
  }

  entity "items" as items {
    * id_item : INT <<PK, generated>>
    --
    * nombre : VARCHAR(150)
    * valor : REAL
    * porcentaje : INT
    * concepto_fijo : BOOLEAN
    observaciones : TEXT
    * fk_id_presupuesto : INT <<FK>>
    version : INT
  }

  entity "pagos" as pagos {
    * id_pago : INT <<PK, generated>>
    --
    * fecha : DATE
    * monto : REAL
    * observaciones : TEXT
    * fk_id_presupuesto : INT <<FK>>
    version : INT
  }

}

package "Protocolos, Escrituración y Registración" {

  entity "escrituras" as escrituras {
    * id_escritura : INT <<PK, generated>>
    --
    * numero : INT
    * fecha_escrituracion : DATE
    * cuerpo : TEXT
    * estado : VARCHAR(50)
    matricula_inscripcion : VARCHAR(100)
    fecha_inscripcion : DATE
    observaciones : TEXT
    version : INT
  }

  entity "tipos_de_folio" as tipos_de_folio {
    * id_tipo_folio : INT <<PK, generated>>
    --
    * nombre : VARCHAR(100)
    observaciones : TEXT
    * habilitado : BOOLEAN
    version : INT
  }

  entity "folios" as folios {
    * id_folio : INT <<PK, generated>>
    --
    * numero : INT
    * anio : INT
    * estado : VARCHAR(50)
    observaciones : TEXT
    * fk_id_persona_escribano : INT <<FK>>
    * fk_id_tipo_folio : INT <<FK>>
    fk_id_escritura : INT <<FK>>
    version : INT
  }

  entity "testimonios" as testimonios {
    * id_testimonio : INT <<PK, generated>>
    --
    * numero : INT
    fecha_inscripcion : DATE
    fecha_retiro : DATE
    fecha_ingreso_libro : DATE
    numero_carpeta : INT
    numero_expediente : INT
    * observado : BOOLEAN
    * reingresado : BOOLEAN
    observaciones : TEXT
    * fk_id_escritura : INT <<FK>>
    version : INT
  }

  entity "movimientos_testimonio" as movimientos_testimonio {
    * id_movimiento_testimonio : INT <<PK, generated>>
    --
    * fecha_ingreso : DATE
    fecha_salida : DATE
    fecha_inscripcion : DATE
    * inscripta : BOOLEAN
    * numero_carton : INT
    observaciones : TEXT
    * fk_id_testimonio : INT <<FK>>
    version : INT
  }

  entity "copias" as copias {
    * id_copia : INT <<PK, generated>>
    --
    * numero : INT
    * fecha_impresion : DATE
    fecha_retiro : DATE
    observaciones : TEXT
    * fk_id_testimonio : INT <<FK>>
    * fk_id_persona : INT <<FK>>
    version : INT
  }

  entity "folios_copias" as folios_copias {
    * fk_id_folio : INT <<PK, FK>>
    * fk_id_copia : INT <<PK, FK>>
    version : INT
  }

}

' =============================================================================
' RELACIONES
' =============================================================================

' Identificaciones y Personas
personas ||--o{ identificaciones : "posee"
tipos_identificacion ||--o{ identificaciones : "clasifica"
personas }o--|| tipos_identificacion : "identificación principal"

' Seguridad y Usuarios
personas ||--o{ usuarios : "identifica"
roles ||--o{ usuarios : "asigna rol"
roles ||--o{ roles_permisos : "concede permisos"
usuarios ||--o{ registro_auditoria : "ejecuta"

' Suplencias entre Escribanos
personas ||--o{ suplencias : "suplantado"
personas ||--o{ suplencias : "suplente"

' Workflow y Estados
estados_de_gestion ||--o{ workflow_node : "asocia estado"
workflow_definition ||--o{ workflow_node : "contiene nodos"
workflow_definition ||--o{ workflow_transition : "contiene transiciones"
workflow_node ||--o{ workflow_transition : "nodo origen"
workflow_node ||--o{ workflow_transition : "nodo destino"
workflow_definition ||--o{ tipos_de_tramite : "workflow asignado"

' Gestiones, Estados e Historial
personas ||--o{ gestiones_de_escrituras : "escribano responsable"
estados_de_gestion ||--o{ gestiones_de_escrituras : "estado actual"
gestiones_de_escrituras ||--o{ historial : "registra historial"
estados_de_gestion ||--o{ historial : "estado histórico"

' Tipos de Trámite y Plantillas
tipos_de_tramite ||--o{ plantilla_tramites : "define requisitos"
tipos_de_documento ||--o{ plantilla_tramites : "documento requerido"
tipos_de_tramite ||--o{ plantilla_presupuestos : "define aranceles"
conceptos ||--o{ plantilla_presupuestos : "concepto arancelario"

' Trámites y sus relaciones
tipos_de_tramite ||--o{ tramites : "tipifica"
gestiones_de_escrituras ||--o{ tramites : "agrupa"
inmuebles ||--o{ tramites : "objeto del acto"
tramites ||--o{ tramites_personas : "participantes"
personas ||--o{ tramites_personas : "interviene en"

' Documentación Presentada
tramites ||--o{ documentos_presentados : "requiere presentación"
tipos_de_documento ||--o{ documentos_presentados : "tipo de documento"

' Presupuestos, Items y Pagos (V14: Un Presupuesto tiene 1..N Trámites)
personas ||--o{ presupuestos : "solicitante"
presupuestos ||--o{ tramites : "presupuesta"
presupuestos ||--o{ items : "compuesto por"
presupuestos ||--o{ pagos : "abona"

' Protocolos, Folios y Escrituras
personas ||--o{ folios : "custodia"
tipos_de_folio ||--o{ folios : "tipo de folio"
escrituras ||--o{ folios : "asienta en"
escrituras ||--o{ tramites : "instrumenta"

' Testimonios, Copias y Movimientos
escrituras ||--o{ testimonios : "expide"
testimonios ||--o{ movimientos_testimonio : "registra tracto registral"
testimonios ||--o{ copias : "emite copias"
personas ||--o{ copias : "destinatario"
folios ||--o{ folios_copias : "utilizado en"
copias ||--o{ folios_copias : "consta de"

@enduml
