# Dockerfile para Notaire Backend API
FROM maven:3.9-eclipse-temurin-21 AS builder

WORKDIR /app

# Copy root + required modules so Maven parent/module resolution stays intact
COPY pom.xml pom.xml
COPY backend-api/ backend-api/
COPY notaire-shared/ notaire-shared/
COPY frontend-swing/ frontend-swing/

# Build backend and required modules from root reactor
RUN mvn clean package -pl backend-api -am -DskipTests

FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

COPY --from=builder /app/backend-api/target/backend-api-1.0-SNAPSHOT.jar app.jar

RUN apk add --no-cache curl

HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8080/swagger-ui.html || exit 1

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]