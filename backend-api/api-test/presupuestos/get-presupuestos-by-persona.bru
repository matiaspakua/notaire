meta {
  name: Get Presupuestos By Persona
  type: http
}

get {
  url: {{base_url}}/api/v1/presupuestos/persona/{{persona_id}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  test("Status 200", function () {
    expect(res.getStatus()).to.equal(200);});
 
  test("Response is array", function () {
  const body = res.getBody();
  expect(body).to.be.an('array');
  });
}
docs {
  ## Get Presupuestos By Persona
  Obtiene los presupuestos de una persona (CU60).
  **Method:** GET
  **Path:** /api/v1/presupuestos/persona/{idPersona}
}
