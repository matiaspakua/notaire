meta {
  name: Get Usuario By ID
  type: http
}

get {
  url: {{base_url}}/api/v1/usuarios/{{user_id}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  test("Status is 200 or 404", function () {
    const status = res.getStatus();
    expect([200, 404]).to.include(status);});
 
  test("Response time under 1000ms", function () {
  expect(res.getResponseTime()).to.be.lessThan(1000);
  });
}
docs {
  ## Get Usuario By ID
  Obtiene un usuario por su ID.
  **Method:** GET
  **Path:** /api/v1/usuarios/{id}
  **Path Parameters:**
  - id: ID del usuario
}
