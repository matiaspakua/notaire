meta {
  name: Get Historial By Gestion
  type: http
}

get {
  url: {{base_url}}/api/v1/historial/gestion/{{gestion_id}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  test("Status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
   
  test("Response is array", function () {
    const body = res.getBody();
    expect(body).to.be.an('array');
  });
}

docs {
  ## Get Historial By Gestion
  Obtiene el historial de una gestión (CU13).
  
  **Method:** GET
  **Path:** /api/v1/historial/gestion/{idGestion}
}
