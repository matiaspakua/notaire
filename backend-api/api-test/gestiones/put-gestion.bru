meta {
  name: Update Gestion
  type: http
}

put {
  url: {{base_url}}/api/v1/gestiones/{{gestion_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  numero: 1002
  fechaInicio: "2025-02-01"
  detalle: "Gestión actualizada"
}

tests {
  test("Status 200", function () {
    expect(res.getStatus()).to.equal(200);});
}
docs {
  ## Update Gestion
  Actualiza una gestión existente en el sistema.
  **Method:** PUT
  **Path:** /api/v1/gestiones/{id}
}
