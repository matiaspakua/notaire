meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/usuarios/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  nombre: admin
  contrasenia: admin
}

tests {
  test("Status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
   
  test("Response has valido field", function () {
    const body = res.getBody();
    expect(body).to.have.property('valido');
  });
   
  test("Login success returns valido true", function () {
    const body = res.getBody();
    if (body.valido === true) {
      bru.setVar('user_id', body.idUsuario);
      bru.setVar('token', 'logged-in');
    }
    expect(body.valido).to.be.a('boolean');
  });
}

docs {
  ## Login Endpoint
  Autentica un usuario en el sistema.
  
  **Method:** POST
  **Path:** /api/v1/usuarios/login
  
  **Request Body:**
  ```json
  {
    "nombre": "string",
    "contrasenia": "string"
  }
  ```
  
  **Response:**
  ```json
  {
    "idUsuario": number,
    "nombre": "string",
    "estado": boolean,
    "tipo": "string",
    "valido": boolean,
    "personas": {
      "idPersona": number,
      "nombre": "string",
      "apellido": "string"
    }
  }
  ```
  
  **Pre-requisitos:**
  - Usuario existente en la base de datos
  - Contraseña en texto plano (se encripta en MD5 en el servidor)
}
