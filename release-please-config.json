{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "8ab8a6e500ac20ca73870d6c5476a39ddab93bec",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "notaire",
      "changelog-path": "CHANGELOG.md",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "xml",
          "path": "pom.xml",
          "xpath": "/project/version"
        },
        {
          "type": "xml",
          "path": "backend-api/pom.xml",
          "xpath": "/project/parent/version"
        },
        {
          "type": "json",
          "path": "frontend/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "release/product-release.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "release/product-release.json",
          "jsonpath": "$.components.backend.version"
        },
        {
          "type": "json",
          "path": "release/product-release.json",
          "jsonpath": "$.components.frontend.version"
        },
        {
          "type": "generic",
          "path": "docker-compose.yml"
        },
        {
          "type": "generic",
          "path": "docker-compose.prod.yml"
        },
        {
          "type": "generic",
          "path": "infra/deploy/kustomize/overlays/staging/kustomization.yaml"
        }
      ]
    }
  }
}
