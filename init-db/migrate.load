/*
 * Script de Migración: MySQL → PostgreSQL
 * =========================================
 * 
 * Este script fue utilizado para migrar la base de datos del proyecto Notaire
 * desde MySQL 5.7 a PostgreSQL 16.
 * 
 * UBICACIÓN: init-db/migrate.load
 * HERRAMIENTA: pgloader (https://pgloader.io/)
 * 
 * -------------------------------------------------------------
 * 
 * DESCRIPCIÓN DEL PROCESO DE MIGRACIÓN
 * -------------------------------------
 * 
 * El proceso de migración de base de datos constó de los siguientes pasos:
 * 
 * 1. EXPORTAR DESDE MYSQL
 *    - Exportar el schema y datos desde MySQL:
 *    mysqldump -u root -p notary > mysql_dump.sql
 * 
 * 2. CONVERSIÓN MANUAL (alternativa a pgloader)
 *    - Dado que pgloader puede tener problemas con tipos específicos,
 *    se realizó una conversión manual del dump SQL:
 *    *Cambio de tipos MySQL a PostgreSQL*
 *    - INT → INTEGER
 *    - DATETIME → TIMESTAMP
 *    - AUTO_INCREMENT → SERIAL
 *    - TEXT → TEXT
 *    - VARCHAR(n) → VARCHAR(n)
 *    - TINYINT(1) → BOOLEAN
 *    - BIGINT → BIGINT
 * 
 * 3. IMPLEMENTACIÓN FINAL (usada en este proyecto)
 *    - Se crearon scripts SQL directamente en init-db/:
 *    * 01-schema.sql  - Creación de tablas
 *    * 02-data.sql    - Datos iniciales
 * 
 * -------------------------------------------------------------
 * 
 * USO DE PGLOADER (método alternativo)
 * ------------------------------------
 * 
 * Si en el futuro necesitas migrar desde MySQL a PostgreSQL y deseas usar pgloader:
 * 
 * 1. Instalar pgloader:
 *    sudo apt-get install pgloader
 *    # o desde código fuente: https://github.com/dimitri/pgloader
 * 
 * 2. Configurar conexión MySQL:
 *    - Asegúrate de tener MySQL corriendo con los datos a migrar
 *    - Credenciales: root:admin@localhost:3306/notaire
 * 
 * 3. Configurar conexión PostgreSQL:
 *    - PostgreSQL debe estar corriendo
 *    - Credenciales: notaire:notaire_password@localhost:5432/notaire
 * 
 * 4. Ejecutar la migración:
 *    cd init-db/
 *    pgloader migrate.load
 * 
 * -------------------------------------------------------------
 * 
 * CONFIGURACIÓN DEL SCRIPT
 * -----------------------
 * 
 * Parámetros principales:
 * - FROM: Cadena de conexión MySQL origen
 * - INTO: Cadena de conexión PostgreSQL destino
 * - WITH: Opciones de migración
 * 
 * Opciones importantes:
 * - include drop: Elimina tablas existentes en PostgreSQL antes de crear
 * - create tables: Crea las tablas automáticamente
 * - create indexes: Crea los índices
 * - reset sequences: Reinicia las secuencias (serial)
 * - workers: Número de procesos paralelos (4)
 * - concurrency: Concurrencia de lectura (2)
 * 
 * CONVERSIONES DE TIPOS
 * ---------------------
 * - tinyint → boolean (MySQL usa TINYINT(1) para booleanos)
 * - int with auto_increment → serial (PostgreSQL auto-increment)
 * - bigint with auto_increment → bigserial
 * 
 * -------------------------------------------------------------
 * 
 * ESTADO ACTUAL
 * ------------
 * 
 * Este script ya NO se usa activamente. La migración se completó
 * exitosamente y ahora se usan los scripts SQL directamente:
 * 
 * - init-db/01-schema.sql  → Schema de PostgreSQL
 * - init-db/02-data.sql    → Datos iniciales
 * 
 * Este archivo se mantiene como referencia histórica del proceso
 * de migración y como guía para futuras migraciones.
 * 
 * -------------------------------------------------------------
 * 
 * NOTAS ADICIONALES
 * -----------------
 * 
 * - PostgreSQL ofrece mejor soporte para tipos complejos
 * - Las transacciones en PostgreSQL son más robustas
 * - HikariCP proporciona connection pooling efectivo
 * - La migración fue necesaria para soportar Spring Boot 3.x
 * 
 * -------------------------------------------------------------
 * 
 * Usage:
 *   1. First, import the MySQL dump into a running MySQL container or local MySQL
 *   2. Then run: pgloader migrate.load
 *
 * Alternative: Direct SQL import (recommended for this project)
 *   Since we have SQL dumps, we'll convert them manually and import directly.
 */

LOAD DATABASE
     FROM mysql://root:admin@localhost:3306/notaire
     INTO postgresql://notaire:notaire_password@localhost:5432/notaire

WITH include drop, create tables, create indexes, reset sequences,
     workers = 4, concurrency = 2

SET MySQL PARAMETERS
    net_read_timeout = 120,
    net_write_timeout = 120

CAST type tinyint to boolean using tinyint-to-boolean,
     type int with auto_increment to serial,
     type bigint with auto_increment to bigserial

ALTER SCHEMA 'notaire' RENAME TO 'public';
