{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CLAUDE.md",
    ".claude/rules/code-quality.md",
    ".claude/rules/programming.md",
    ".claude/rules/refactoring.md",
    ".claude/skills/*/SKILL.md",
    ".claude/skills/*/references/*.md"
  ],
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/Users/matiasmiguez/workspace/notaire"],
      "enabled": true
    },
    "drawio": {
      "type": "local",
      "command": ["npx", "-y", "@drawio/mcp"],
      "enabled": true
    }
  },
  "tools": {
    "github": false,
    "filesystem": true,
    "git": true
  },
  "agent": {
    "build": {
      "prompt": "{file:CLAUDE.md}",
      "temperature": 0.3
    },
    "plan": {
      "temperature": 0.1,
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    },
    "code-reviewer": {
      "mode": "subagent",
      "description": "Code review agent focused on security, performance and best practices"
    },
    "security-auditor": {
      "mode": "subagent", 
      "description": "Security expert focused on identifying vulnerabilities and security issues"
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  }
}