# =============================================================================
# Notaire — Single source of truth for all service credentials & config
# =============================================================================
# Copy this file to `.env` (which is git-ignored) and adjust as needed.
# Both the application stack (./docker-compose.yml) and the infrastructure
# stack (./infra/docker-compose.yml) read from this single file.
#
#   cp .env.example .env
#
# Start everything with:  bash scripts/start-all.sh
# =============================================================================

# --- Application database (PostgreSQL) -------------------------------------
# INSECURE PLACEHOLDER — CHANGE BEFORE FIRST PRODUCTION RUN.
POSTGRES_DB=notaire
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# --- pgAdmin (PostgreSQL web admin, http://localhost:5050) ------------------
# INSECURE PLACEHOLDER — CHANGE BEFORE FIRST PRODUCTION RUN.
PGADMIN_DEFAULT_EMAIL=admin@notaire.com
PGADMIN_DEFAULT_PASSWORD=admin

# --- Backend application login (seeded admin user) --------------------------
# Used by the Next.js frontend login form. Stored in DB as a BCrypt hash
# (issue #554). Seeded once on first startup if no admin user exists yet
# (issue #651). INSECURE PLACEHOLDER — CHANGE BEFORE FIRST PRODUCTION RUN.
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=admin

# --- JWT signing secret (backend authentication) -----------------------------
# Mandatory — the backend fails to start if this is blank, shorter than 32
# bytes, or left as an example value. Generate a real one per environment,
# e.g.: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-bytes

# --- Backend Actuator / Prometheus metrics (HTTP Basic auth) ----------------
# Prometheus scrapes /actuator/prometheus with these credentials.
# NOTE: also referenced in infra/prometheus/prometheus.yml (basic_auth block).
# INSECURE PLACEHOLDER — CHANGE BEFORE FIRST PRODUCTION RUN.
ACTUATOR_USER=admin
ACTUATOR_PASSWORD=admin

# --- Grafana (http://localhost:3001) ----------------------------------------
# INSECURE PLACEHOLDER — CHANGE BEFORE FIRST PRODUCTION RUN.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- SonarQube database (internal) ------------------------------------------
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar

# --- SonarQube (http://localhost:9000) --------------------------------------
# Initial credentials. SonarQube forces a password change on first login;
# scripts/run-sonar.sh handles that and stores the working password here.
SONAR_ADMIN_USER=admin
SONAR_ADMIN_PASSWORD=Admin@123456
# Token used by `mvn sonar:sonar` (generated by scripts/run-sonar.sh).
SONAR_TOKEN=
