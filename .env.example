# Environment variables for Notaire Docker setup
# Copy this file to .env and modify as needed

# ===== APPLICATION DATABASE =====
# PostgreSQL Configuration
POSTGRES_DB=notaire
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Application Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notaire
DB_USER=admin
DB_PASSWORD=admin

# ===== BACKEND API =====
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/notaire
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin
SPRING_JPA_HIBERNATE_DDL_AUTO=none
ENVIRONMENT=development

# ===== MONITORING =====
# Prometheus scrape credentials (for /actuator/prometheus)
ACTUATOR_USERNAME=admin
ACTUATOR_PASSWORD=admin

# Grafana (configured in infra/grafana/grafana.ini)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Jenkins (configured in infra/jenkins/jenkins.yaml)
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=admin

# ===== INFRASTRUCTURE =====
# SonarQube
SONAR_HOST_URL=http://sonarqube:9000
SONAR_LOGIN=admin
SONAR_PASSWORD=admin

# Nexus
NEXUS_URL=http://nexus:8081
NEXUS_USERNAME=admin
NEXUS_PASSWORD=admin123

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@notaire.com
PGADMIN_DEFAULT_PASSWORD=admin
