# =============================================================================
# Notaire — Single source of truth for all service credentials & config
# =============================================================================
# Copy this file to `.env` (which is git-ignored) and adjust as needed.
# The development stack (./docker-compose.yml), production stack
# (./docker-compose.prod.yml), and infrastructure stack
# (./infra/observability/docker-compose.yml) read from this single file.
#
#   cp .env.example .env
#
# Development:  bash scripts/start-all.sh
# Production:   docker compose -f docker-compose.prod.yml --env-file .env up -d --build
#               (requires non-admin secrets — compose uses ${VAR:?} and will fail
#               if values are missing; see docs/200-architecture/209-deployment/)
# =============================================================================

# --- Application database (PostgreSQL) -------------------------------------
# INSECURE PLACEHOLDER — CHANGE BEFORE FIRST PRODUCTION RUN.
POSTGRES_DB=notaire
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# --- pgAdmin (PostgreSQL web admin, http://localhost:5050) ------------------
# INSECURE PLACEHOLDER — CHANGE BEFORE FIRST PRODUCTION RUN.
PGADMIN_DEFAULT_EMAIL=admin@notaire.com
PGADMIN_DEFAULT_PASSWORD=admin

# --- Backend application login (seeded admin user) --------------------------
# Used by the Next.js frontend login form. Stored in DB as a BCrypt hash
# (issue #554). Seeded once on first startup if no admin user exists yet
# (issue #651). INSECURE PLACEHOLDER — CHANGE BEFORE FIRST PRODUCTION RUN.
# Outside ENVIRONMENT=development/dev/local/test the seed is skipped while this
# is blank or "admin" (issue #1249).
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=admin

# --- JWT signing secret (backend authentication) -----------------------------
# Mandatory — the backend fails to start if this is blank, shorter than 32
# bytes, or left as an example value. Generate a real one per environment,
# e.g.: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-bytes

# --- HttpOnly JWT session cookie (issue #1051) --------------------------------
# Secure flag for the browser auth cookie. Leave false for local HTTP
# (Docker/dev); set true in HTTPS / production deployments.
COOKIE_SECURE=false
# Optional overrides (defaults shown):
# AUTH_COOKIE_NAME=notaire-auth-token
# AUTH_COOKIE_MAX_AGE_SECONDS=86400

# --- Frontend → backend BFF (issue #1055) ------------------------------------
# Server-only URL used by the Next.js /api/v1 Route Handler at request time.
# Compose sets this on the frontend service; do NOT put Docker-internal hosts
# in NEXT_PUBLIC_* (browser stays on same-origin /api/v1).
# BACKEND_URL=http://backend:8080/api/v1

# --- Backend Actuator / Prometheus metrics (HTTP Basic auth) ----------------
# Prometheus scrapes /actuator/prometheus with these credentials.
# NOTE: also referenced in infra/observability/prometheus/prometheus.yml (basic_auth block).
# INSECURE PLACEHOLDER — CHANGE BEFORE FIRST PRODUCTION RUN.
ACTUATOR_USER=admin
ACTUATOR_PASSWORD=admin

# --- Grafana (http://localhost:3001) ----------------------------------------
# INSECURE PLACEHOLDER — CHANGE BEFORE FIRST PRODUCTION RUN.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- PostgreSQL metrics-exporter role (least-privilege, pg_monitor only) ----
# Created by Flyway migration V12 (issue #675) — do NOT reuse POSTGRES_USER/
# POSTGRES_PASSWORD here; a compromised exporter should never get full DB
# access. INSECURE PLACEHOLDER PASSWORD — CHANGE BEFORE FIRST PRODUCTION RUN.
POSTGRES_EXPORTER_USER=notaire_exporter
POSTGRES_EXPORTER_PASSWORD=admin

# --- SonarQube database (internal) ------------------------------------------
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar

# --- SonarQube (http://localhost:9000) --------------------------------------
# Initial credentials. SonarQube forces a password change on first login;
# scripts/run-sonar.sh handles that and stores the working password here.
SONAR_ADMIN_USER=admin
SONAR_ADMIN_PASSWORD=Admin@123456
# Token used by `mvn sonar:sonar` (generated by scripts/run-sonar.sh).
SONAR_TOKEN=

# --- OpenAPI export / DAST targets (issue #1067, optional) --------------------
# scripts/export-openapi.sh prefers a live API at OPENAPI_BASE_URL, else Maven/H2.
# ZAP baseline CI targets http://localhost:8080 (see .github/workflows/dast-zap.yml).
# OPENAPI_BASE_URL=http://localhost:8080

# --- Parallel dev stacks (issue #1186, optional) ------------------------------
# Override host ports and container names to run a second stack beside the first
# (pair with a distinct COMPOSE_PROJECT_NAME). Defaults match the values below.
# The observability stack (infra/) only supports the default container names.
# POSTGRES_PORT=5432
# BACKEND_PORT=8080
# PGADMIN_PORT=5050
# FRONTEND_PORT=3000
# NOTAIRE_POSTGRES_CONTAINER_NAME=notary-postgres
# NOTAIRE_BACKEND_CONTAINER_NAME=notary-backend
# NOTAIRE_PGADMIN_CONTAINER_NAME=notary-pgadmin
# NOTAIRE_FRONTEND_CONTAINER_NAME=notaire-frontend
