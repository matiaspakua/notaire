#!/usr/bin/env bash
#
# pre-push — run the pull-request gate locally before anything reaches the remote.
#
# Installed by: bash workspace/sdlc/install-git-hooks.sh  (sets core.hooksPath=.githooks)
#
# Runs `bash workspace/sdlc/preflight.sh`, the pull-request gate (#2493): format, lint, compile, typecheck,
# process checks and the unit tests and builds of the suite groups the branch touches (#2413). The
# server-backed suites (Playwright, Bruno, Docker, database V&V) gate the release: `preflight.sh --all`
# before release-please is dispatched, then the version-tag CI. A push is aborted if any check fails.
# A commit that already passed in the same or a more complete mode (pr < full < all) is not gated again;
# preflight.sh records the pass itself ($(git rev-parse --git-common-dir)/preflight-pass/).
#
#   PREFLIGHT_FULL=1 git push …    add the server-backed suites (risky change: auth, Flyway, REST contract)
#   PREFLIGHT_ALL=1 git push …     every suite (the release gate)
# Escape hatches (use deliberately, not habitually):
#   PREFLIGHT_SKIP=1 git push …    skip entirely (e.g. pushing a WIP spike)
#   PREFLIGHT_FAST=1 git push …    format/lint/compile/typecheck only
#   git push --no-verify …         bypass all hooks (git built-in)
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

if [ "${PREFLIGHT_SKIP:-0}" = "1" ]; then
    echo "pre-push: PREFLIGHT_SKIP=1 — skipping local CI gates."
    exit 0
fi

# Nothing to validate when the push only deletes refs.
ZERO=0000000000000000000000000000000000000000
ONLY_DELETES=1
PUSHED=()
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    [ "$local_sha" = "$ZERO" ] && continue
    ONLY_DELETES=0
    PUSHED+=("$local_sha")
done
[ "$ONLY_DELETES" = "1" ] && exit 0

if [ "${PREFLIGHT_ALL:-0}" = "1" ]; then
    ARGS=(--all); MODE=all
elif [ "${PREFLIGHT_FULL:-0}" = "1" ]; then
    ARGS=(--full); MODE=full
elif [ "${PREFLIGHT_FAST:-0}" = "1" ]; then
    ARGS=(--fast); MODE=fast
else
    ARGS=(); MODE=pr
fi

# The gate checks the checked-out commit, so a recorded pass only counts when that is what is pushed.
HEAD_SHA="$(git rev-parse HEAD)"
CACHE_DIR="$(git rev-parse --path-format=absolute --git-common-dir)/preflight-pass"
ONLY_HEAD=1
for sha in "${PUSHED[@]}"; do
    [ "$sha" = "$HEAD_SHA" ] || ONLY_HEAD=0
done
# A pass covers its own mode and every weaker one: pr < full < all.
passed() {
    local covering
    case "$MODE" in
        pr)   covering="pr full all" ;;
        full) covering="full all" ;;
        all)  covering="all" ;;
        *)    return 1 ;;
    esac
    for m in $covering; do
        [ -f "$CACHE_DIR/$HEAD_SHA.$m" ] && return 0
    done
    return 1
}
if [ "$MODE" != "fast" ] && [ "$ONLY_HEAD" = "1" ] && passed; then
    echo "pre-push: $HEAD_SHA already passed preflight ($MODE); not running it again."
    exit 0
fi

echo "pre-push: running the pull-request gate (workspace/sdlc/preflight.sh ${ARGS[*]:-}, mode $MODE)…"
echo "          skip with PREFLIGHT_SKIP=1, or git push --no-verify"

if bash "$REPO_ROOT/workspace/sdlc/preflight.sh" ${ARGS[@]+"${ARGS[@]}"}; then
    if [ "$MODE" != "fast" ]; then
        mkdir -p "$CACHE_DIR" && touch "$CACHE_DIR/$HEAD_SHA.$MODE"
    fi
    exit 0
fi

cat <<'MSG'

pre-push: BLOCKED — the pull-request gate failed. GitHub does not re-run it on the
pull request.

  fix automatically :  bash workspace/sdlc/preflight.sh --fix
  re-check          :  bash workspace/sdlc/preflight.sh
  push anyway       :  PREFLIGHT_SKIP=1 git push …   (or: git push --no-verify)
MSG
exit 1
