#!/usr/bin/env bash
#
# pre-push — run the CI gates locally before anything reaches the remote.
#
# Installed by: bash scripts/install-git-hooks.sh  (sets core.hooksPath=.githooks)
#
# Runs scripts/preflight.sh in its default mode: every blocking CI gate that does
# not need a running app stack. A push is aborted if any of them fail, so a PR is
# never opened against a branch that CI would reject.
#
# Escape hatches (use deliberately, not habitually):
#   PREFLIGHT_SKIP=1 git push …    skip entirely (e.g. pushing a WIP spike)
#   PREFLIGHT_FAST=1 git push …    format/lint/compile/typecheck only
#   git push --no-verify …         bypass all hooks (git built-in)
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

if [ "${PREFLIGHT_SKIP:-0}" = "1" ]; then
    echo "pre-push: PREFLIGHT_SKIP=1 — skipping local CI gates."
    exit 0
fi

# Nothing to validate when the push only deletes refs.
ONLY_DELETES=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] || ONLY_DELETES=0
done
[ "$ONLY_DELETES" = "1" ] && exit 0

ARGS=()
[ "${PREFLIGHT_FAST:-0}" = "1" ] && ARGS+=(--fast)

echo "pre-push: running local CI gates (scripts/preflight.sh ${ARGS[*]:-})…"
echo "          skip with PREFLIGHT_SKIP=1, or git push --no-verify"

if bash "$REPO_ROOT/scripts/preflight.sh" "${ARGS[@]}"; then
    exit 0
fi

cat <<'MSG'

pre-push: BLOCKED — the checks above are the same ones CI runs, so this push
would produce a red PR.

  fix automatically :  bash scripts/preflight.sh --fix
  re-check          :  bash scripts/preflight.sh
  push anyway       :  PREFLIGHT_SKIP=1 git push …   (or: git push --no-verify)
MSG
exit 1
