#!/usr/bin/env bash
#
# pre-push — run the pull-request gate locally before anything reaches the remote.
#
# Installed by: bash workspace/sdlc/install-git-hooks.sh  (sets core.hooksPath=.githooks)
#
# Runs `bash workspace/sdlc/preflight.sh --full`. That is the mandatory gate
# (#2001). GitHub Actions does not re-run the suite on the pull request.
# A push is aborted if any check fails.
#
# Escape hatches (use deliberately, not habitually; not sufficient to open a PR):
#   PREFLIGHT_SKIP=1 git push …    skip entirely (e.g. pushing a WIP spike)
#   PREFLIGHT_FAST=1 git push …    format/lint/compile/typecheck only
#   git push --no-verify …         bypass all hooks (git built-in)
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

if [ "${PREFLIGHT_SKIP:-0}" = "1" ]; then
    echo "pre-push: PREFLIGHT_SKIP=1 — skipping local CI gates."
    exit 0
fi

# Nothing to validate when the push only deletes refs.
ONLY_DELETES=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] || ONLY_DELETES=0
done
[ "$ONLY_DELETES" = "1" ] && exit 0

if [ "${PREFLIGHT_FAST:-0}" = "1" ]; then
    ARGS=(--fast)
else
    ARGS=(--full)
fi

echo "pre-push: running local CI gates (workspace/sdlc/preflight.sh ${ARGS[*]})…"
echo "          skip with PREFLIGHT_SKIP=1, or git push --no-verify"

if bash "$REPO_ROOT/workspace/sdlc/preflight.sh" "${ARGS[@]}"; then
    exit 0
fi

cat <<'MSG'

pre-push: BLOCKED — these checks are the pull-request gate. GitHub will not
re-run them on the pull request.

  fix automatically :  bash workspace/sdlc/preflight.sh --fix
  re-check          :  bash workspace/sdlc/preflight.sh --full
  push anyway       :  PREFLIGHT_SKIP=1 git push …   (or: git push --no-verify)
MSG
exit 1
