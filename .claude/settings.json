{
  "permissions": {
    "readOnly": [
      "Bash:bash",
      "Read:read",
      "Bash:grep",
      "Bash:find",
      "Bash:cat",
      "Bash:ls"
    ]
  },
  "enabledPlugins": {
    "remember@claude-plugins-official": true,
    "code-modernization@claude-plugins-official": true,
    "github@claude-plugins-official": false
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-openspec-status.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-push-to-main.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
