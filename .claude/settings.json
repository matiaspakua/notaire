{
  "permissions": {
    "readOnly": [
      "Bash:bash",
      "Read:read",
      "Bash:grep",
      "Bash:find",
      "Bash:cat",
      "Bash:ls"
    ],
    "allow": [
      "mcp__repolens"
    ]
  },
  "enabledPlugins": {
    "remember@claude-plugins-official": true,
    "code-modernization@claude-plugins-official": true,
    "github@claude-plugins-official": false
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-toolchain.sh\"",
            "timeout": 600
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-openspec-status.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-push-to-main.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-unpublished-work.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|mcp__repolens__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/framework/repolens/bin/repolens\" hook",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "repolens"
  ]
}
