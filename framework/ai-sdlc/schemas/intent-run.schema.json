{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisdlc.dev/schemas/intent-run.schema.json",
  "title": "Factory intent run event",
  "description": "One append-only line in the intent log. example=true marks a fixture, not a measurement. Token and cost fields stay null when the harness did not report them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event", "run_id", "recorded_at"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "event": {"enum": ["start", "tool", "end"]},
    "run_id": {"type": "string", "minLength": 1},
    "intent_id": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "issue": {"type": ["string", "null"]},
    "pull_request": {"type": ["string", "null"]},
    "harness": {"type": ["string", "null"]},
    "provider": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "knowledge": {"type": "string", "minLength": 1},
    "knowledge_version": {"type": ["string", "null"]},
    "started_at": {"type": ["string", "null"]},
    "ended_at": {"type": ["string", "null"]},
    "duration_s": {"type": ["number", "null"], "minimum": 0},
    "tool_calls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "by_kind"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "by_kind": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cached_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "outcome": {"enum": ["success", "fail", null]},
    "preflight_restarts": {"type": "integer", "minimum": 0},
    "retries": {"type": "integer", "minimum": 0},
    "files_touched": {"type": "array", "items": {"type": "string"}},
    "commit": {"type": ["string", "null"]},
    "example": {"type": "boolean"},
    "recorded_at": {"type": "string"},
    "kind": {"type": "string"},
    "n": {"type": "integer", "minimum": 1},
    "note": {"type": "string"}
  }
}
