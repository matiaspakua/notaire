#!/usr/bin/env python3
"""Entry point: `aisdlc <command>` without installing anything (Python 3.11+, stdlib only)."""
import sys
from pathlib import Path

if sys.version_info < (3, 11):
    sys.stderr.write("aisdlc needs Python 3.11 or newer (tomllib)\n")
    sys.exit(2)

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from aisdlc.cli import main  # noqa: E402

sys.exit(main())
