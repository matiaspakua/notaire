#!/usr/bin/env bash
# repolens launcher: runs this checkout's repolens from any directory, so every worktree serves its own code.
# Python: $REPOLENS_PYTHON, else the shared environment $REPOLENS_HOME/venv (`repolens setup --install`),
# else python3 from PATH.
set -euo pipefail
MODULE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SHARED="${REPOLENS_HOME:-$HOME/.cache/repolens}/venv/bin/python"
if [[ -n "${REPOLENS_PYTHON:-}" ]]; then
  PY="$REPOLENS_PYTHON"
elif [[ -x "$SHARED" ]]; then
  PY="$SHARED"
else
  PY="$(command -v python3)"
fi
export PYTHONPATH="$MODULE${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m repolens "$@"
